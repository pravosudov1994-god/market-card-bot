{
  "name": "market-card-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram-бот для генерации карточек маркетплейсов на Cloudflare",
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply market-card-bot-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply market-card-bot-db --remote",
    "webhook:set": "node scripts/set-webhook.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22.6"
  }
}
