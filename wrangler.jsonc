{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-card-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-24",
  "workers_dev": true,
  "keep_vars": true,
  "minify": true,
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "market-card-bot-db",
      "database_id": "46d7f036-9363-43bd-beac-041512e73c01",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BOT_NAME": "MarketCard AI",
    "SUBSCRIPTION_STARS": "60",
    "PRICE_LABEL_RUB": "≈99 ₽",
    "MONTHLY_GENERATIONS": "20",
    "FREE_GENERATIONS": "5"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
